{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Bot de música para Discord usando discord.js, ytdl-core y yt-dlp",
  "main": "src/index.js",
  "scripts": {
    "start": "node ./src/index.js"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "youtube-dl-exec": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.11.0",
    "dotenv": "^16.0.0",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.2",
    "youtube-dl-exec": "^3.0.0"
  }
}
